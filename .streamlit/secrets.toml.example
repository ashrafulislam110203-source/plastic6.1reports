# Nothing here is required. The app works with zero secrets: it stores its data in a local
# SQLite file (data/kpi.db) that it creates automatically on first run.
#
# Copy only what you actually want into Streamlit Cloud's own Secrets panel
# (app -> Settings -> Secrets). Do NOT commit a real secrets.toml to GitHub -
# .gitignore already excludes it.

# Optional: locks the app behind a password. Leave this out entirely for no password.
KPI_APP_PASSWORD = "choose-a-password"
